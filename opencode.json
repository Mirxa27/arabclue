{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp"
    },
    "zai-mcp-server": {
      "command": [
        "npx",
        "-y",
        "@z_ai/mcp-server"
      ],
      "type": "local"
    }
  },
  "model": "google/gemini-3-pro-preview",
  "plugin": [
    "opencode-scheduler",
    "@different-ai/opencode-browser"
  ]
}
