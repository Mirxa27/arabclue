APP_NAME="HabibiStay"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=habibistay
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_ORGANIZATION=

# AI Configuration
AI_PRIMARY_MODEL=gpt-4-turbo-preview
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000
AI_DAILY_TOKEN_LIMIT=1000000
AI_CACHING_ENABLED=true

# Sara Chatbot
SARA_ENABLED=true
SARA_CONTEXT_WINDOW=10
SARA_SESSION_TIMEOUT=7200
SARA_MAX_DAILY_CONVERSATIONS=100

# Social Authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="${APP_URL}/auth/apple/callback"

# Payment Gateways
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

MYFATOORAH_API_KEY=
MYFATOORAH_MODE=test
MYFATOORAH_COUNTRY=SA

# Push Notifications
FCM_SERVER_KEY=
FCM_SENDER_ID=

APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.habibistay.app
APNS_PRIVATE_KEY_PATH=
APNS_ENVIRONMENT=sandbox

# SMS Services
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Maps and Geocoding
GOOGLE_MAPS_API_KEY=

# File Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Analytics
GOOGLE_ANALYTICS_TRACKING_ID=
GOOGLE_ANALYTICS_MEASUREMENT_ID=

# Error Tracking
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# WhatsApp Business API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# HabibiStay Specific
HABIBISTAY_SUPPORT_EMAIL=support@habibistay.com
HABIBISTAY_SUPPORT_PHONE="+966550800669"
HABIBISTAY_SUPPORT_WHATSAPP="+966550800669"
HABIBISTAY_NOREPLY_EMAIL=noreply@habibistay.com
HABIBISTAY_BOOKING_EMAIL=bookings@habibistay.com

AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OpenAI API for Sara
OPENAI_API_KEY=
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"